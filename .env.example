# AgentMesh — copy to .env. Every value here is optional: the stack runs with
# none of them, using the local Ollama backend.

# ─── Gateway ──────────────────────────────────────────────────────────────
# Credential the Temporal workers present to agentgateway. It must be a signed
# JWT — `mode: strict` rejects anything else — and its `sub` must be a
# registered Cedar principal. Mint one with:
#
#   python3 scripts/agent_token.py issue orchestrator --ttl 604800
#
# Tokens expire. A worker that starts returning 401 has an expired credential,
# not a broken policy.
GATEWAY_TOKEN=
DEFAULT_MODEL=llama3

# ─── Ollama (self-hosted) ─────────────────────────────────────────────────
# Where your Ollama server lives. Must be a FULL URL including the scheme and
# the /v1 suffix — agentgateway's ollama provider takes a base URL, not a
# host:port pair.
#
#   another machine   http://192.168.1.20:11434/v1
#   this Docker host  http://host.docker.internal:11434/v1
#   in-compose        http://ollama:11434/v1   (docker compose --profile local-llm up -d)
#
# Ollama binds to 127.0.0.1 by default, so a server on another machine needs
# OLLAMA_HOST=0.0.0.0 set on *that* machine before it will accept connections.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# ─── Published ports ──────────────────────────────────────────────────────
# Only the host side is configurable; container-internal ports never change,
# so nothing else needs editing when you move one. Override any that a stack
# already running on this machine has taken — 4000, 4317/4318 and 3000 are
# popular (Grafana Alloy, DevLake, Grafana itself all claim them).
#
# Symptom of a clash:
#   Bind for 0.0.0.0:4317 failed: port is already allocated
# Find the holder with:  ss -lntp | grep :4317
GATEWAY_PORT=4000
GATEWAY_ADMIN_PORT=15000
CEDAR_AGENT_PORT=8180
PRESIDIO_ANALYZER_PORT=5001
PRESIDIO_ANONYMIZER_PORT=5002
# cedar-shim and presidio-adapter are not published at all — they are internal
# to the compose network. See the comments on them in docker-compose.yml.
OLLAMA_PORT=11434
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

# ─── LLM backends ─────────────────────────────────────────────────────────
# Add a key and its model family becomes reachable through the same gateway,
# with the same guardrails and authorization. Leave blank to disable.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# Anthropic models on Azure AI Foundry. agentgateway routes claude-* to
# /anthropic/v1/messages and injects version headers itself.
AZURE_API_KEY=
AZURE_FOUNDRY_RESOURCE=
AZURE_FOUNDRY_PROJECT=

# ─── PII guardrail ────────────────────────────────────────────────────────
# reject | mask.  Default `reject` is what "PII must never be sent" requires,
# and it works regardless of whether this agentgateway build honours a webhook
# mask action (the vendor docs disagree — see presidio-adapter/main.py).
GUARDRAIL_ACTION=reject
PRESIDIO_SCORE_THRESHOLD=0.5
# Entities that trigger the guardrail. Leaving this empty means "every entity
# Presidio knows", which blocks ordinary prompts — "What is the capital of
# France?" trips LOCATION.
#
# Excluded: LOCATION, DATE_TIME, NRP, URL, MAC_ADDRESS — and PERSON, which is
# the one that costs something. Name-level NER has too many false positives to
# gate traffic on ("MoE" reads as a person), and in a multi-turn agent every
# false positive is fatal because each reply becomes the next prompt. What keeps
# an agent on-premises is Cedar's allowed_model_tiers, not this list.
PRESIDIO_ENTITIES=EMAIL_ADDRESS,PHONE_NUMBER,US_SSN,US_ITIN,US_PASSPORT,US_DRIVER_LICENSE,US_BANK_NUMBER,CREDIT_CARD,IBAN_CODE,CRYPTO,MEDICAL_LICENSE,UK_NHS,IP_ADDRESS,INTERNAL_EMPLOYEE_ID

# ─── Observability ────────────────────────────────────────────────────────
# Langfuse accepts OTLP over HTTP only. Create a project in the Langfuse UI,
# then: LANGFUSE_BASIC_AUTH=$(printf 'pk-lf-...:sk-lf-...' | base64 -w0)
LANGFUSE_OTLP_ENDPOINT=http://host.docker.internal:3000/api/public/otel
LANGFUSE_BASIC_AUTH=

# ─── Temporal ─────────────────────────────────────────────────────────────
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
