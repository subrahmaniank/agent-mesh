# AgentMesh — copy to .env. Every value here is optional: the stack runs with
# none of them, using the local Ollama backend.

# ─── Gateway ──────────────────────────────────────────────────────────────
# Credential agents present to agentgateway. agentgateway maps it to an agent
# identity, which is what Cedar authorizes — agents never assert their own.
GATEWAY_TOKEN=dev-operator-token
DEFAULT_MODEL=llama3

# ─── LLM backends ─────────────────────────────────────────────────────────
# Add a key and its model family becomes reachable through the same gateway,
# with the same guardrails and authorization. Leave blank to disable.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# Anthropic models on Azure AI Foundry. agentgateway routes claude-* to
# /anthropic/v1/messages and injects version headers itself.
AZURE_API_KEY=
AZURE_FOUNDRY_RESOURCE=
AZURE_FOUNDRY_PROJECT=

# ─── PII guardrail ────────────────────────────────────────────────────────
# reject | mask.  Default `reject` is what "PII must never be sent" requires,
# and it works regardless of whether this agentgateway build honours a webhook
# mask action (the vendor docs disagree — see presidio-adapter/main.py).
GUARDRAIL_ACTION=reject
PRESIDIO_SCORE_THRESHOLD=0.5

# ─── Observability ────────────────────────────────────────────────────────
# Langfuse accepts OTLP over HTTP only. Create a project in the Langfuse UI,
# then: LANGFUSE_BASIC_AUTH=$(printf 'pk-lf-...:sk-lf-...' | base64 -w0)
LANGFUSE_OTLP_ENDPOINT=http://host.docker.internal:3000/api/public/otel
LANGFUSE_BASIC_AUTH=

# ─── Temporal ─────────────────────────────────────────────────────────────
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
